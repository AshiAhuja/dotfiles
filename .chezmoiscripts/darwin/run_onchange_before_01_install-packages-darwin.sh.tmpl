#!/usr/bin/env bash
export PATH="$HOME/.local/bin/:$PATH"
bindir="$HOME/.local/bin/"
mkdir -p "$bindir"

{{ if eq .chezmoi.os "darwin" }}
cat << "EOF"
  __  __             ____  _____
 |  \/  |           / __ \/ ____|
 | \  / | __ _  ___| |  | | (___
 | |\/| |/ _` |/ __| |  | |\___ \
 | |  | | (_| | (__| |__| |____) |
 |_|  |_|\__,_|\___|\____/|_____/
EOF

echo "Installing Homebrew packages for profile: {{ .profile }}"

# Load base packages
{{ $base := include ".chezmoidata/packages/darwin/base.yaml" | fromYaml }}

# Load profile-specific packages
{{ $profile := include (printf ".chezmoidata/packages/darwin/%s.yaml" .profile) | fromYaml }}

# Merge base + profile
{{ $brews := concat $base.brews $profile.brews | uniq }}
{{ $casks := concat $base.casks $profile.casks | uniq }}

if command -v brew >/dev/null 2>&1; then
  brew install {{ range $brews }}{{.}} {{ end }}
  brew install --cask {{ range $casks }}{{.}} {{ end }}
else
  echo "Homebrew not found. Installing..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  brew install {{ range $brews }}{{.}} {{ end }}
  brew install --cask {{ range $casks }}{{.}} {{ end }}
fi

{{ end }}